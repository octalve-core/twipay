# Public/non-secret configuration
NODE_ENV=development
APP_NAME=TwiPay
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
TRUST_PROXY=false

# Server-only infrastructure secrets (values belong in local secret store/deployment environment)
DATABASE_URL=
REDIS_URL=
SESSION_HASH_PEPPER=
DATA_ENCRYPTION_KEY=

# Authentication / OAuth (server-only unless explicitly marked public)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# Initial provider placeholders - values intentionally blank
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
MONO_SECRET_KEY=
TERMII_API_KEY=
RESEND_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
