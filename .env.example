# Public/non-secret configuration
NODE_ENV=development
APP_NAME=TwiPay
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
TRUST_PROXY=false
OPENAPI_DOCS_ENABLED=false

# Server-only infrastructure secrets (values belong in local secret store/deployment environment)
DATABASE_URL=
REDIS_URL=
SESSION_HASH_PEPPER=
# Independent, secret 32+ character pepper for 4-digit transaction PIN HMAC + Argon2id
TRANSACTION_PIN_PEPPER=
# Separate, release-controlled financial authorization. Defaults OFF even when feature flags are ON.
# Sandbox-only. Real KYC tier approval/limits require independently reviewed, audited controls.
FINANCIAL_AUTHORIZATION_SANDBOX_ENABLED=false
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400
SESSION_TOUCH_INTERVAL_SECONDS=300
MFA_STEP_UP_MAX_AGE_SECONDS=600
MFA_RECOVERY_HMAC_KEY=
MFA_TOTP_ISSUER=TwiPay
MFA_ENROLLMENT_TTL_SECONDS=600
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCK_SECONDS=300
HIGH_RISK_FEATURES_RELEASE_QUALIFIED=false
DATA_ENCRYPTION_KEY=
PII_FINGERPRINT_KEY=

# Authentication / OAuth (server-only unless explicitly marked public)
GOOGLE_OIDC_ENABLED=false
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_OIDC_TRANSACTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# Initial provider placeholders - values intentionally blank
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_SOURCE_ACCOUNT_NUMBER=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_ALLOW_UNSIGNED_SANDBOX_WEBHOOKS=false
PAYSTACK_BASE_URL=https://api.paystack.co
MONO_BASE_URL=https://api.withmono.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com
MONO_SECRET_KEY=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com
RESEND_API_KEY=
RESEND_FROM=
RESEND_BASE_URL=https://api.resend.com
TICKET_SIGNING_KEYS_JSON=
TICKET_SIGNING_CURRENT_VERSION=1

# Batch 3 product policies (not secrets)
BILL_VALIDATION_TTL_MINUTES=15
BILL_RECONCILE_MAX_ATTEMPTS=12
BILL_RECONCILE_BASE_DELAY_MS=30000
BILL_RECONCILE_MAX_DELAY_MS=900000
EVENT_PLATFORM_FEE_BPS=0
EVENT_ORDER_EXPIRY_MINUTES=10
WORKER_RECOVERY_SWEEP_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MS=60000
NOTIFICATION_PROCESSING_STALE_MS=300000

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# C2 funding collection is disabled server-side unless an explicitly qualified sandbox is used.
WALLET_COLLECTIONS_SANDBOX_ENABLED=false

# Batch C3: NEVER enable bank payouts outside isolated authorized sandbox tests.
BANK_TRANSFERS_SANDBOX_ENABLED=false
# Phase 4.2: no fee assumed, no quote issued until independently reviewed SANDBOX schedule and secret are configured.
# Fee values are NGN kobo and MUST be independently approved; no guessed provider pricing.
TRANSFER_FEE_SANDBOX_APPROVED=false
# TRANSFER_FEE_PAYSTACK_MINOR=
# TRANSFER_FEE_MONNIFY_MINOR=
# TRANSFER_QUOTE_HMAC_KEY=  # independent secret, >=32 bytes in hex; NEVER reuse PII or session keys

# Batch C4: provisioning is OFF by default, even in test and staging
VIRTUAL_ACCOUNTS_SANDBOX_ENABLED=false

# Batch D: utilities may only be validated/purchased in non-production sandbox after qualification.
BILL_PURCHASES_SANDBOX_ENABLED=false
# Phase 4.5: signed utility quotes, independent >=32-byte hex secret; never reuse other keys.
# BILL_QUOTE_HMAC_KEY=
BILL_FEE_POLICY_SANDBOX_APPROVED=false
# Fee only explicitly approved 0 until separate fee-ledger accounting is qualified.
# BILL_CUSTOMER_FEE_MINOR=0

# Batch E: event wallet debit and ticket issuance OFF until qualified in isolated non-production sandbox.
EVENT_PUBLISH_SANDBOX_ENABLED=false
EVENT_CHECKOUT_SANDBOX_ENABLED=false
EVENT_TICKET_QR_SANDBOX_ENABLED=false

# Phase 6.3B owner governance mutations. Sandbox ONLY; independently reviewed,
# recent-MFA maker/checker. Always blocked in production, even if true.
OWNER_GOVERNANCE_SANDBOX_ENABLED=false

# High-risk provider routing changes stay disabled in production and default disabled in sandbox.
PROVIDER_OPERATIONS_SANDBOX_ENABLED=false
