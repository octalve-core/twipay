{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://twipay-api.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "installCommand": "cd ../.. && npx -y pnpm@12.9.1 install --frozen-lockfile",
  "buildCommand": "cd ../.. && node apps/customer-ui/scripts/sync-guide-images.mjs && npx -y pnpm@12.9.1 --filter @twipay/customer-ui exec vite build",
  "outputDirectory": "dist"
}
