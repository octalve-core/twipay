VITE_TWIPAY_API_URL=http://localhost:4000
# APP_URL on API must match Vite origin exactly (e.g. http://localhost:5173).

# C2 sandbox-only; disabled by default. Production must remain false until verification.
VITE_TWIPAY_FUNDING_SANDBOX_ENABLED=false

# Batch C3: requires independent server-side sandbox qualification.
VITE_TWIPAY_TRANSFER_SANDBOX_ENABLED=false
# Batch C4: user-facing virtual-account provisioning (non-production sandbox only)
VITE_TWIPAY_VIRTUAL_ACCOUNT_SANDBOX_ENABLED=false

# Batch D: separate frontend switch; server must independently allow non-production sandbox purchases.
VITE_TWIPAY_BILLS_SANDBOX_ENABLED=false

# Batch E: event checkout must be separately qualified on API side.
VITE_TWIPAY_EVENT_CHECKOUT_SANDBOX_ENABLED=false
