  action      String   @db.VarChar(120)
  targetType  String   @db.VarChar(80)
  targetId    String   @db.VarChar(120)
  reason      String?  @db.VarChar(500)
  requestId   String?  @db.VarChar(64)
  beforeState Json?
  afterState  Json?
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([action, occurredAt])
  @@map("operational_audit_events")
}

model BillOfferEquivalenceVerification {
  id                 String   @id @default(uuid()) @db.Uuid
  providerOfferId    String   @db.Uuid
  previousProductId  String   @db.Uuid
  canonicalProductId String   @db.Uuid
  verifiedByUserId   String   @db.Uuid
  evidence           Json
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  providerOffer      BillProviderOffer @relation(fields: [providerOfferId], references: [id], onDelete: Restrict)
  previousProduct    BillProduct @relation("EquivalencePreviousProduct", fields: [previousProductId], references: [id], onDelete: Restrict)
  canonicalProduct   BillProduct @relation("EquivalenceCanonicalProduct", fields: [canonicalProductId], references: [id], onDelete: Restrict)
  verifiedBy         User @relation(fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@index([providerOfferId, createdAt])
  @@index([canonicalProductId, createdAt])
  @@map("bill_offer_equivalence_verifications")
}

model FeatureFlag {
  key             String   @id @db.VarChar(120)
  enabled         Boolean  @default(false)
  public          Boolean  @default(false)
  description     String?  @db.VarChar(500)
  config          Json?
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([public, enabled])
  @@map("feature_flags")
}

model BrandConfiguration {
  key             String   @id @default("default") @db.VarChar(80)
  productName     String   @default("TwiPay") @db.VarChar(120)
  legalName       String   @default("Octalve Ltd") @db.VarChar(180)
  domain          String   @default("twipay.co") @db.VarChar(255)
  supportEmail    String   @default("support@twipay.co") @db.VarChar(320)
  logoUrl         String?  @db.VarChar(1000)
  primaryColor    String   @default("#5B2A86") @db.Char(7)
  accentColor     String   @default("#C59A35") @db.Char(7)
  privacyUrl      String?  @db.VarChar(1000)
  termsUrl        String?  @db.VarChar(1000)
  metadata        Json?
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("brand_configurations")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String?            @db.Uuid
  channel        NotificationChannel
  templateCode   String             @db.VarChar(100)
  destinationCiphertext String      @db.Text
  destinationFingerprint String     @db.Char(64)
  destinationLast4 String?          @db.VarChar(4)
  subject        String?            @db.VarChar(200)
  bodyCiphertext String             @db.Text
  status         NotificationStatus @default(PENDING)
  idempotencyKey String             @unique @db.VarChar(160)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts       NotificationAttempt[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  notificationId    String             @db.Uuid
  providerCode      String             @db.VarChar(40)
  providerReference String?            @db.VarChar(160)
  status            NotificationStatus
  failureCode       String?            @db.VarChar(100)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  notification      Notification       @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([notificationId, createdAt])
  @@map("notification_attempts")
}


model DeploymentProfile {
  key             String   @id @db.VarChar(80)
  productSlug     String   @db.VarChar(120)
  edition         String   @db.VarChar(40)
  licensedTo      String   @db.VarChar(180)
  status          String   @db.VarChar(30)
  allowedModules  Json?
  supportMode     String   @db.VarChar(40)
  licenseReference String? @db.VarChar(160)
  validUntil      DateTime? @db.Timestamptz(6)
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("deployment_profiles")
}
