generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum IdentityProvider {
  GOOGLE
}

enum FinancialEligibilityStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaCredentialStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum SecurityEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  GOOGLE_IDENTITY_LINKED
  MFA_ENROLLMENT_STARTED
  MFA_ENABLED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
  MFA_RECOVERY_USED
  MFA_DISABLED
  SESSION_ROTATED
  SESSION_EXPIRED
  ACCOUNT_SUSPENDED
  CONTACT_CHALLENGE_ISSUED
  CONTACT_CHALLENGE_FAILED
  CONTACT_EMAIL_VERIFIED
  PASSWORD_ENROLLMENT_REQUESTED
  PASSWORD_ENROLLED
  TRANSACTION_PIN_SET
  TRANSACTION_PIN_CHANGED
  TRANSACTION_PIN_FAILED
  TRANSACTION_PIN_LOCKED
  TRANSACTION_PIN_RESET_REQUESTED
  TRANSACTION_PIN_RESET
  FINANCIAL_PIN_AUTHORIZED
}

enum LedgerAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum JournalEntrySide {
  DEBIT
  CREDIT
}

enum WalletStatus {
  ACTIVE
  RESTRICTED
  FROZEN
  CLOSED
}

enum WalletHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum FinancialTransactionType {
  FUNDING
  TRANSFER
  BILL_PAYMENT
  EVENT_PURCHASE
  REFUND
  REVERSAL
  FEE
  ADJUSTMENT
  ORGANIZER_PAYOUT
}

enum FinancialTransactionStatus {
  CREATED
  AUTHORIZED
  FUNDS_RESERVED
  PROVIDER_SUBMITTED
  PROCESSING
  UNKNOWN
  SUCCEEDED
  FAILED
  REVERSED
  CANCELLED
}

enum ProviderOperationType {
  COLLECTION
  VIRTUAL_ACCOUNT
  PAYOUT
  IDENTITY_CHECK
  BILL_PURCHASE
  NOTIFICATION
}

enum ProviderOperationStatus {
  PENDING
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REVERSED
  UNKNOWN
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum VirtualAccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  FAILED
}

enum BankTransferStatus {
  CREATED
  VALIDATED
  PROCESSING
  UNKNOWN
  SUCCEEDED
  FAILED
  REVERSED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum IdentityCheckType {
  BVN
  NIN
  BANK_ACCOUNT
  CAC
}

enum IdentityCheckStatus {
  CREATED
  AWAITING_CONSENT
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum ReconciliationCaseType {
  PROVIDER_STATUS_MISMATCH
  AMOUNT_MISMATCH
  MISSING_INTERNAL
  MISSING_PROVIDER
  DUPLICATE_EVENT
  LEDGER_MISMATCH
  SERVICE_FULFILLMENT_MISMATCH
  EVENT_SETTLEMENT_MISMATCH
  REFUND_MISMATCH
  ORGANIZER_PAYOUT_MISMATCH
}


enum BillCategory {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
}

enum BillProductStatus {
  ACTIVE
  INACTIVE
}

enum BillPurchaseStatus {
  CREATED
  VALIDATING
  VALIDATED
  FUNDS_RESERVED
  PROVIDER_SUBMITTED
  PROCESSING
  UNKNOWN
  SUCCEEDED
  FAILED
  REVERSED
  CANCELLED
}

enum ProviderCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum EventOrganizerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SALES_PAUSED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum TicketTypeStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  CLOSED
}

enum EventOrderStatus {
  CREATED
  FUNDS_RESERVED
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  CHECKED_IN
  CANCELLED
  REFUNDED
  VOID
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
}

enum ReconciliationCaseStatus {
  OPEN
  AUTO_REPAIRED
  NEEDS_REVIEW
  RESOLVED
  IGNORED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  REJECTED
}

enum OrganizerPayoutStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  PROVIDER_SUBMITTED
  PROCESSING
  UNKNOWN
  SUCCEEDED
  FAILED
  REJECTED
  REVERSED
}

enum EventStaffRole {
  CHECK_IN
}

enum EventStaffStatus {
  ACTIVE
  REVOKED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  emailVerifiedAt DateTime?     @db.Timestamptz(6)
  givenName       String?       @db.VarChar(100)
  familyName      String?       @db.VarChar(100)
  phoneE164       String?       @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?     @db.Timestamptz(6)
  countryCode     String?       @db.Char(2)
  stateRegion     String?       @db.VarChar(100)
  status          UserStatus    @default(PENDING)
  lastLoginAt     DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  passwordCredential    PasswordCredential?
  oauthIdentities       OAuthIdentity[]
  googleOidcTransactions GoogleOidcTransaction[]
  sessions              Session[]
  contactChallenges     ContactVerificationChallenge[]
  passwordResetChallenges PasswordResetChallenge[]
  passwordEnrollmentChallenges PasswordEnrollmentChallenge[]
  financialEligibility FinancialEligibilityPolicy?
  transactionPin TransactionPinCredential?
  transactionPinResetChallenges TransactionPinResetChallenge[]
  securityEvents        SecurityEvent[]
  mfaCredentials        MfaCredential[]
  roleAssignments       UserRole[]
  wallets               Wallet[]
  ledgerAccounts        LedgerAccount[]
  financialTransactions FinancialTransaction[]
  idempotencyRecords    IdempotencyRecord[]
  virtualAccounts       VirtualAccount[]
  beneficiaries         Beneficiary[]
  identityVerifications IdentityVerification[]
  providerOperations     ProviderOperation[]
  eventOrganizers        EventOrganizer[]
  eventOrders            EventOrder[]
  ticketCheckIns         TicketCheckIn[] @relation("TicketCheckInStaff")
  eventStaffMemberships  EventStaffAssignment[] @relation("EventStaffMember")
  eventStaffAssignmentsMade EventStaffAssignment[] @relation("EventStaffInviter")
  notifications          Notification[]
  billPurchases          BillPurchase[]
  billCustomerValidations BillCustomerValidation[]
  disputes              Dispute[]
  refundRequests        RefundRequest[] @relation("RefundRequester")
  refundReviews         RefundRequest[] @relation("RefundReviewer")
  refundApprovals       RefundRequest[] @relation("RefundApprover")
  payoutRequests        OrganizerPayout[] @relation("PayoutRequester")
  payoutPreparations    OrganizerPayout[] @relation("PayoutPreparer")
  payoutApprovals       OrganizerPayout[] @relation("PayoutApprover")
  operationalAuditEvents OperationalAuditEvent[]
  offerEquivalenceVerifications BillOfferEquivalenceVerification[]
  featureFlagsUpdated   FeatureFlag[]
  brandConfigurationsUpdated BrandConfiguration[]
  deploymentProfilesUpdated DeploymentProfile[]

  @@index([status])
  @@map("users")
}

model ContactVerificationChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  email          String   @db.VarChar(320)
  codeHash       String   @db.Char(64)
  failedAttempts Int      @default(0)
  expiresAt      DateTime @db.Timestamptz(6)
  consumedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("contact_verification_challenges")
}

/** Password recovery codes are never stored in plaintext. A password reset never issues a session. */
model PasswordResetChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  email          String    @db.VarChar(320)
  codeHash       String    @db.Char(64)
  failedAttempts Int       @default(0)
  expiresAt      DateTime  @db.Timestamptz(6)
  consumedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_challenges")
}

/** Only an authenticated, email-verified Google-only account may request password enrollment. */
model PasswordEnrollmentChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  sessionId      String    @db.Uuid
  email          String    @db.VarChar(320)
  codeHash       String    @db.Char(64)
  failedAttempts Int       @default(0)
  expiresAt      DateTime  @db.Timestamptz(6)
  consumedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_enrollment_challenges")
}

/** HMAC-secret peppered, Argon2id transaction PIN; never a session or MFA credential. */
/** Explicit approval record; absent records and zero limits deny all financial intents.
 *  Never auto-create APPROVED records from a KYC provider response. */
model FinancialEligibilityPolicy {
  userId              String                     @id @db.Uuid
  status              FinancialEligibilityStatus @default(PENDING)
  approvedKycTier     Int                        @default(0)
  maxPerIntentMinor   BigInt                     @default(0)
  maxDailyDebitMinor  BigInt                     @default(0)
  approvedAt          DateTime?                  @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("financial_eligibility_policies")
}

model TransactionPinCredential {
  userId         String    @id @db.Uuid
  pinHash        String    @db.Text
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  changedAt      DateTime  @default(now()) @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("transaction_pin_credentials")
}

model TransactionPinResetChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  sessionId      String    @db.Uuid
  email          String    @db.VarChar(320)
  codeHash       String    @db.Char(64)
  failedAttempts Int       @default(0)
  expiresAt      DateTime  @db.Timestamptz(6)
  consumedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("transaction_pin_reset_challenges")
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.Text
  changedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model OAuthIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String           @db.VarChar(255)
  providerEmail   String?          @db.VarChar(320)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_identities")
}

/** Short-lived, one-time OIDC authorization state, never an authentication credential. */
model GoogleOidcTransaction {
  id                 String    @id @default(uuid()) @db.Uuid
  stateHash          String    @unique @db.Char(64)
  bindingHash        String    @db.Char(64)
  verifierCiphertext String    @db.Text
  nonce              String    @db.VarChar(255)
  purpose            String    @db.VarChar(12)
  userId             String?   @db.Uuid
  sessionId          String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt          DateTime  @db.Timestamptz(6)
  consumedAt         DateTime? @db.Timestamptz(6)
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("google_oidc_transactions")
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  tokenHash       String        @unique @db.Char(64)
  csrfTokenHash   String        @db.Char(64)
  status          SessionStatus @default(ACTIVE)
  userAgent       String?       @db.VarChar(512)
  ipHash          String?       @db.Char(64)
  mfaSatisfiedAt  DateTime?     @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime      @db.Timestamptz(6)
  revokedAt       DateTime?     @db.Timestamptz(6)
  revokeReason    String?       @db.VarChar(120)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model MfaCredential {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  status               MfaCredentialStatus @default(PENDING)
  secretCiphertext     String              @db.Text
  lastAcceptedTimeStep BigInt?             @db.BigInt
  failedAttempts       Int                 @default(0)
  lockedUntil          DateTime?           @db.Timestamptz(6)
  enrollmentStartedAt  DateTime            @default(now()) @db.Timestamptz(6)
  enabledAt            DateTime?           @db.Timestamptz(6)
  disabledAt           DateTime?           @db.Timestamptz(6)
  disabledReason       String?             @db.VarChar(160)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes        MfaRecoveryCode[]

  @@index([userId, status])
  @@index([lockedUntil])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id           String        @id @default(uuid()) @db.Uuid
  credentialId String        @db.Uuid
  codeHash     String        @unique @db.Char(64)
  usedAt       DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([credentialId, usedAt])
  @@map("mfa_recovery_codes")
}

model SecurityEvent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @db.Uuid
  type        SecurityEventType
  ipHash      String?           @db.Char(64)
  userAgent   String?           @db.VarChar(512)
  requestId   String?           @db.VarChar(64)
  metadata    Json?
  occurredAt  DateTime          @default(now()) @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@map("security_events")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  assignedBy String?  @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model LedgerAccount {
  id            String                @id @default(uuid()) @db.Uuid
  code          String                @unique @db.VarChar(160)
  name          String                @db.VarChar(160)
  category      LedgerAccountCategory
  normalBalance LedgerNormalBalance
  currency      String                @db.Char(3)
  status        LedgerAccountStatus   @default(ACTIVE)
  system        Boolean               @default(false)
  ownerUserId   String?               @db.Uuid
  metadata      Json?
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  ownerUser     User?                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  wallet        Wallet?
  entries       JournalEntry[]
  organizerSettlementProfile EventOrganizer?

  @@index([ownerUserId, currency])
  @@index([category, currency, status])
  @@map("ledger_accounts")
}

model Wallet {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  currency        String       @db.Char(3)
  status          WalletStatus @default(ACTIVE)
  ledgerAccountId String       @unique @db.Uuid
  version         Int          @default(0)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  holds           WalletHold[]

  @@unique([userId, currency])
  @@index([status])
  @@map("wallets")
}

model FinancialTransaction {
  id             String                     @id @default(uuid()) @db.Uuid
  reference      String                     @unique @db.VarChar(80)
  userId         String?                    @db.Uuid
  type           FinancialTransactionType
  status         FinancialTransactionStatus @default(CREATED)
  currency       String                     @db.Char(3)
  amountMinor    BigInt
  feeMinor       BigInt                     @default(0)
  description    String?                    @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(6)
  user           User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  stateChanges   FinancialTransactionStateChange[]
  journals       JournalTransaction[]
  holds          WalletHold[]
  providerOps    ProviderOperation[]
  bankTransfer   BankTransfer?
  billPurchase   BillPurchase?
  eventOrder     EventOrder?
  reconciliationCases ReconciliationCase[]
  disputes       Dispute[]
  refundsAgainst  RefundRequest[] @relation("RefundOriginalTransaction")
  refundTransaction RefundRequest? @relation("RefundFinancialTransaction")
  organizerPayout OrganizerPayout?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("financial_transactions")
}

model FinancialTransactionStateChange {
  id                     String                     @id @default(uuid()) @db.Uuid
  financialTransactionId String                     @db.Uuid
  fromStatus             FinancialTransactionStatus?
  toStatus               FinancialTransactionStatus
  reason                 String?                    @db.VarChar(255)
  actorType              String                     @default("SYSTEM") @db.VarChar(40)
  actorId                 String?                    @db.VarChar(100)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  financialTransaction   FinancialTransaction       @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@index([financialTransactionId, createdAt])
  @@map("financial_transaction_state_changes")
}

model JournalTransaction {
  id                     String                @id @default(uuid()) @db.Uuid
  reference              String                @unique @db.VarChar(100)
  financialTransactionId String?               @db.Uuid
  reversalOfId           String?               @unique @db.Uuid
  currency               String                @db.Char(3)
  description            String?               @db.VarChar(255)
  metadata               Json?
  postedAt               DateTime?             @db.Timestamptz(6)
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)
  reversalOf             JournalTransaction?   @relation("JournalReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal               JournalTransaction?   @relation("JournalReversals")
  entries                JournalEntry[]

  @@index([financialTransactionId])
  @@map("journal_transactions")
}

model JournalEntry {
  id                   String             @id @default(uuid()) @db.Uuid
  journalTransactionId String             @db.Uuid
  ledgerAccountId      String             @db.Uuid
  sequence             Int
  side                 JournalEntrySide
  amountMinor          BigInt
  memo                 String?            @db.VarChar(255)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  journalTransaction   JournalTransaction @relation(fields: [journalTransactionId], references: [id], onDelete: Restrict)
  ledgerAccount        LedgerAccount      @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([journalTransactionId, sequence])
  @@index([ledgerAccountId, createdAt])
  @@map("journal_entries")
}

model WalletHold {
  id                     String           @id @default(uuid()) @db.Uuid
  walletId               String           @db.Uuid
  financialTransactionId String           @db.Uuid
  amountMinor            BigInt
  status                 WalletHoldStatus @default(ACTIVE)
  expiresAt              DateTime?        @db.Timestamptz(6)
  capturedAt             DateTime?        @db.Timestamptz(6)
  releasedAt             DateTime?        @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(6)
  wallet                 Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  financialTransaction   FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@unique([financialTransactionId, walletId])
  @@index([walletId, status])
  @@map("wallet_holds")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  scope          String            @db.VarChar(120)
  key            String            @db.VarChar(128)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
