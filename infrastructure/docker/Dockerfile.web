FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json pnpm-lock.yaml .npmrc ./
COPY apps ./apps
COPY packages ./packages
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @twipay/web build

FROM node:24.21.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000
RUN corepack enable && groupadd --system twipay && useradd --system --gid twipay --home /app twipay
COPY --from=build --chown=twipay:twipay /app /app
USER twipay
EXPOSE 3000
# Run next directly: pnpm/corepack cannot write its cache as the non-root runtime user.
WORKDIR /app/apps/web
CMD ["node","./node_modules/next/dist/bin/next","start","-p","3000"]
