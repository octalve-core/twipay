FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json pnpm-lock.yaml ./
COPY apps ./apps
COPY packages ./packages
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @twipay/admin build

FROM node:24.21.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3001
RUN corepack enable && groupadd --system twipay && useradd --system --gid twipay --home /app twipay
COPY --from=build --chown=twipay:twipay /app /app
USER twipay
EXPOSE 3001
CMD ["pnpm","--filter","@twipay/admin","start"]
