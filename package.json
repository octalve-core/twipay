{
  "name": "twipay",
  "version": "0.1.0",
  "private": true,
  "description": "TwiPay financial, utility and event orchestration platform by Octalve.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:repo": "node scripts/typescript-syntax-check.mjs && node scripts/repository-security-check.mjs && node scripts/architecture-check.mjs && node scripts/financial-invariant-check.mjs && node scripts/services-events-invariant-check.mjs && node scripts/product-operations-invariant-check.mjs && node scripts/production-hardening-invariant-check.mjs && node scripts/design/erhapay-ui-inventory.mjs --check",
    "format": "prettier --write scripts/review-harness apps/customer-ui/src/routes/external-pages/Guide.tsx apps/customer-ui/src/routes/external-pages/guideData.ts apps/customer-ui/scripts/sync-guide-images.mjs",
    "format:check": "prettier --check scripts/review-harness apps/customer-ui/src/routes/external-pages/Guide.tsx apps/customer-ui/src/routes/external-pages/guideData.ts apps/customer-ui/scripts/sync-guide-images.mjs",
    "db:generate": "pnpm --filter @twipay/database prisma:generate",
    "db:migrate": "pnpm --filter @twipay/database prisma:migrate",
    "db:studio": "pnpm --filter @twipay/database prisma:studio",
    "e2e": "playwright test",
    "e2e:legacy-web-reference": "playwright test --config playwright.legacy-web.config.ts",
    "test:history-secrets": "node scripts/git-history-secret-check.mjs",
    "test:phase3-1:source": "node --experimental-strip-types --test docs/phase3/test/*.test.mjs",
    "test:phase1": "node --test docs/integration/test/phase1-reconciliation.test.mjs",
    "test:phase1-3": "node --test docs/integration/test/phase1-toolchain.test.mjs",
    "test:phase1-4-6": "node --test docs/integration/test/phase1-4-6.test.mjs docs/integration/test/phase1-csrf-hosting.test.mjs scripts/test/stack-readiness.test.mjs",
    "test:isolated-regression": "node --experimental-strip-types --test docs/migration/test/*.test.mjs docs/qualification/batch-f-ticket-security.test.mjs",
    "qualify:phase1-3": "node scripts/qualification/phase1-3-preflight.mjs",
    "qualify:phase1-4-6": "node scripts/qualification/phase1-4-6-gates.mjs",
    "design:inventory": "node scripts/design/erhapay-ui-inventory.mjs --check",
    "test:design": "node --test docs/design/test/*.test.mjs",
    "test:offline-regression": "node --experimental-strip-types --test docs/migration/test/*.test.mjs docs/design/test/*.test.mjs docs/integration/test/*.test.mjs docs/phase3/test/*.test.mjs docs/phase4/test/*.test.mjs docs/phase5/test/*.test.mjs docs/phase6/test/*.test.mjs docs/qualification/batch-f-ticket-security.test.mjs apps/admin/test/*.test.mjs scripts/test/stack-readiness.test.mjs",
    "test:betting-exclusion": "node scripts/qualification/betting-exclusion-check.mjs",
    "test:betting-bundle": "node scripts/qualification/betting-exclusion-check.mjs --built",
    "test:walkthrough-guards": "node --test tests/walkthrough/*.test.mjs tests/walkthrough/matrix/*.test.mjs",
    "walkthrough:stage": "node tests/walkthrough/stage.mjs",
    "walkthrough:matrix": "node tests/walkthrough/matrix/build-matrix.mjs --out out/walkthrough/run",
    "walkthrough:selftest": "WT_SELFTEST=1 playwright test -c playwright.walkthrough.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "turbo": "2.11.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.71.0"
  }
}
