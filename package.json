{
  "name": "twipay",
  "version": "0.1.0",
  "private": true,
  "description": "TwiPay financial, utility and event orchestration platform by Octalve.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:repo": "node scripts/typescript-syntax-check.mjs && node scripts/repository-security-check.mjs && node scripts/architecture-check.mjs && node scripts/financial-invariant-check.mjs && node scripts/services-events-invariant-check.mjs && node scripts/product-operations-invariant-check.mjs && node scripts/production-hardening-invariant-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @twipay/database prisma:generate",
    "db:migrate": "pnpm --filter @twipay/database prisma:migrate",
    "db:studio": "pnpm --filter @twipay/database prisma:studio",
    "e2e": "playwright test",
    "test:history-secrets": "node scripts/git-history-secret-check.mjs",
    "test:phase1": "node --test docs/integration/test/phase1-reconciliation.test.mjs",
    "test:phase1-3": "node --test docs/integration/test/phase1-toolchain.test.mjs",
    "qualify:phase1-3": "node scripts/qualification/phase1-3-preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "turbo": "2.11.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.71.0",
    "@playwright/test": "1.63.0"
  }
}
